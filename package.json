{
  "name": "book-highlights-importer",
  "version": "0.1.0",
  "description": "Import book highlights and notes into managed Obsidian Markdown sections.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:release",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "yandex-book-api-ts": "file:./yandex-book-api-ts-0.0.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
